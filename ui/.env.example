# Firebase configuration — copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Firebase project settings ───────────────────────────────────────────────
# Find these in: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=adoption-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adoption-portal
VITE_FIREBASE_STORAGE_BUCKET=adoption-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here

# ─── Local development ────────────────────────────────────────────────────────
# Set to "true" to point the Firebase SDK at local emulators instead of production.
VITE_USE_EMULATOR=false
